# Superseded by arch/arm64/configs/ax630c_nanokvm_pro_defconfig.
# Pro no longer merges this fragment (that stacked it on arm64 defconfig).
# NanoKVM Pro AX630C (AX620E family) — serial + Ethernet + NFS root
CONFIG_ARCH_AXERA=y
CONFIG_COMMON_CLK_AXERA=y
CONFIG_COMMON_CLK_AX620E=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AXERA=y
CONFIG_PINCTRL_AX620E=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_AXERA=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_AXERA=y
CONFIG_MFD_SYSCON=y
CONFIG_REGMAP=y
CONFIG_REGMAP_MMIO=y

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y

CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_AXERA=y
CONFIG_PHYLIB=y
CONFIG_FIXED_PHY=y
# Vendor PHY is JLSemi; Realtek's RTL8211F binds by mistake and then panics.
# CONFIG_REALTEK_PHY is not set
CONFIG_MDIO_DEVICE=y
CONFIG_MDIO_DEVRES=y
CONFIG_OF_MDIO=y

CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_CADENCE=y

CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_AXERA=y
CONFIG_USB_DWC3_DUAL_ROLE=y
# CONFIG_USB_DWC3_HOST is not set
CONFIG_USB_STORAGE=y

CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
CONFIG_IP_PNP_RARP=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_EXT4_FS=y
CONFIG_PRINTK_TIME=y
CONFIG_BLK_DEV=y
CONFIG_PM=y
CONFIG_OF=y
CONFIG_SMP=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC=y
CONFIG_CLKSRC_ARM_ARCH_TIMER=y
# Axera BL31 hangs on SMCCC HV_PV_TIME_FEATURES (pv_time_init).
# CONFIG_PARAVIRT is not set
# CONFIG_KVM is not set
